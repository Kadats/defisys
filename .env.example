# --- DefiSys v3: Configurações de Ambiente ---

# --- Frontend (Próximo à camada do usuário) ---
# Use o IP Público da VPS para acesso externo: http://<IP_PUBLICO>:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# No frontend, NEXT_PUBLIC_WS_URL é derivado de NEXT_PUBLIC_API_URL, mas pode ser definido aqui se necessário.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Backend API & Segurança (CORS) ---
# Lista de origens permitidas separadas por vírgula. 
# Importante incluir o endereço que o navegador do usuário usará para o frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://<IP_DA_VPS>:3000

# --- Banco de Dados (Docker Interno) ---
# Nota: No Docker Compose, o host deve ser o nome do serviço ('postgres')
DATABASE_URL=postgresql://user:password@postgres:5432/defisys
TEST_DATABASE_URL=postgresql://user:password@postgres_test:5432/defisys_test
PAPER_DATABASE_URL=postgresql://user:password@postgres_paper:5432/defisys_paper_trading

# --- Modelos de IA & LLM (Trading Strategy & Risk) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROK_API_KEY=

# --- Infraestrutura & Auditoria (Nível 2.1 Multi-RPC Failover) ---
ENVIRONMENT=sandbox
# RPCs (Nível 3.2 Resilience Protocol)
RPC_URL_PRIMARY=
RPC_URL_SECONDARY=
RPC_URL_DECENTRALIZED=

# --- Resiliência de Rede ---
NETWORK_TIMEOUT_SECONDS=5.0
NETWORK_RETRY_ATTEMPTS=3

# --- Dados DeFi (The Graph / Uniswap / Binance) ---
THEGRAPH_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
