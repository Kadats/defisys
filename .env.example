# --- Banco de Dados (Essencial para o Docker subir) ---
# O formato padrão costuma ser: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://defisys_user:defisys_pass@db:5432/defisys_db

# --- Dados DeFi (The Graph / Uniswap) ---
# Necessário para ver volume real nas DEX
THEGRAPH_API_KEY=

# --- Google Gemini API (LLM Risk Manager) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Grok (xAI) ---
GROK_API_KEY=

# --- Auditoria Nível 2 (Infraestrutura) ---
# ENVIRONMENT: sandbox | production
ENVIRONMENT=sandbox
# RPCs Prioritizados (Nível 2.1 Multi-RPC Failover)
RPC_URL_PRIMARY=
RPC_URL_SECONDARY=
RPC_URL_DECENTRALIZED=
# Resiliência de Rede
NETWORK_TIMEOUT_SECONDS=5.0
NETWORK_RETRY_ATTEMPTS=3
